# ───────────────────────────────────────────────────────────
#  Ankurit configuration — copy this file to ".env" and fill in.
#  Never share your .env file or commit it to GitHub.
# ───────────────────────────────────────────────────────────

# 1) REQUIRED for AI: free Google Gemini API key  →  https://aistudio.google.com/app/apikey
#    You can add MORE keys (made with different Google accounts). When one key
#    reaches its free daily limit, the next key is used automatically:
#      GEMINI_API_KEY=key1,key2,key3
#    or one per line:
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=



# Optional: force a specific Gemini model, e.g. gemini-2.5-flash
# BEST: leave it EMPTY — the server then picks working free "Flash" models itself.
GEMINI_MODEL=

# 2) OPTIONAL free BACKUP AI services — used automatically when every Gemini
#    key/model is busy or out of quota. Add any you like (each is free to sign up).
#    Several keys per service are allowed: KEY1,KEY2
#
#    Groq   (very fast; can also read crop photos)  →  https://console.groq.com/keys
GROQ_API_KEY=
#    Mistral (free "Experiment" plan; can read photos)  →  https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
#    OpenRouter (many free models; pick one ending in ":free" at https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
#    Any other OpenAI-compatible service
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
OPENAI_VISION=false

# 3) OPTIONAL: let the chat assistant use live Google Search (prices, schemes,
#    weather). Uses Gemini "grounding" — has its own free daily limit.
AI_WEB_SEARCH=false

# 4) Farm news — minutes between refreshes (default 15).
NEWS_REFRESH_MIN=15
# Optional: replace the news sources (JSON on ONE line). Types: "quintype" (base URL)
# or "rss" (feed URL). Example:
# NEWS_FEEDS=[{"id":"agrowon","name":"Agrowon","lang":"mr","type":"quintype","base":"https://agrowon.esakal.com"}]

# Seconds to wait for a Gemini model to start answering before trying the next one
AI_TIMEOUT_SEC=25

# Server
PORT=3000
# Max AI requests per minute per visitor (protects your free quota)
RATE_LIMIT_PER_MIN=30
