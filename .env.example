# ───────────────────────────────────────────────────────────
#  Ankurit configuration — copy this file to ".env" and fill in.
#  Never share your .env file or commit it to GitHub.
# ───────────────────────────────────────────────────────────

# 1) REQUIRED for AI: free Google Gemini API key
#    Get it here: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: force a specific Gemini model. Leave empty to auto-pick the
# newest free "Flash" model available to your key.
GEMINI_MODEL=

# 2) OPTIONAL backup provider (any OpenAI-compatible API).
#    Used for text answers when Gemini hits its free limit.
#    Default below is Groq (free key: https://console.groq.com/keys).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile
# Set to true only if the backup model can read images.
OPENAI_VISION=false

# Server
PORT=3000
# Max AI requests per minute per visitor (protects your free quota)
RATE_LIMIT_PER_MIN=30
